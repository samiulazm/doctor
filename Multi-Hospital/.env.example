# Copy to .env and set values (never commit .env).
# CI_ENV is read in index.php (development | testing | production).

CI_ENV=production

# Public URL (with trailing slash). If unset, base URL is derived from the request.
# CI_BASE_URL=https://your-hospital.example.com/

# CodeIgniter encryption key (32+ chars). Generate: openssl rand -hex 32
CI_ENCRYPTION_KEY=

# Database (optional; defaults in database.php apply when unset)
# CI_DB_HOST=127.0.0.1
# CI_DB_USER=root
# CI_DB_PASSWORD=
# CI_DB_NAME=democa_hmz_v2

# Session file path (optional; default is application/cache/sessions)
# CI_SESSION_PATH=

# Optional: comma-separated extra hostnames allowed for same-site redirects (referer / safe_redirect),
# e.g. when base_url uses one hostname and links use www or another vhost.
# CI_ALLOW_REDIRECT_HOSTS=www.example.com,example.com
