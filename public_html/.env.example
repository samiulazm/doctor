# Copy to .env and set values (never commit .env).
# Full production checklist: ../docs/ship-to-production/PRODUCTION_ENV.md (sibling of public_html)
# Generate CI_ENCRYPTION_KEY: php scripts/generate_encryption_key.php  (or openssl rand -hex 32)
# Validate launch readiness: php scripts/ship_preflight.php
# dotenv_loader.php loads (1) .env in the directory *above* public_html, then (2) public_html/.env (overrides the first).
# On cPanel, put production secrets in /home/USER/.env (outside public_html); keep public_html/.env minimal or local overrides.
# CI_ENV is read in index.php (development | testing | production).

CI_ENV=production

# Public URL (with trailing slash). If unset, base URL is derived from the request
# (uses Host and X-Forwarded-Host / HTTPS proxy headers when present).
# If CI_BASE_URL still points to an old http://IP/... or ~/user/ path but the app is served on a domain,
# it is ignored for that request unless you set CI_BASE_URL_STRICT=1.
# CI_BASE_URL=https://your-hospital.example.com/
# CI_BASE_URL_STRICT=1

# CodeIgniter encryption key (32+ chars). Generate: openssl rand -hex 32
CI_ENCRYPTION_KEY=

# Database
# Required in testing/production. In development, database.php falls back to local defaults if unset.
# "Connection refused" = DB server not running or wrong host/port (Laragon: Start All).
# CI_DB_HOST=127.0.0.1
# CI_DB_USER=root
# CI_DB_PASSWORD=
# CI_DB_NAME=democa_hmz_v2
# CI_DB_PORT=3306
# CI_SKIP_DB_LISTEN_CHECK=1

# Session file path (optional; default is application/cache/sessions)
# CI_SESSION_PATH=

# Optional: comma-separated extra hostnames allowed for same-site redirects (referer / safe_redirect),
# e.g. when base_url uses one hostname and links use www or another vhost.
# CI_ALLOW_REDIRECT_HOSTS=www.example.com,example.com

# --- FTP deploy (python deploy.py) — keep secrets only in local .env, never commit .env ---
# FTP_HOST=151.158.44.114
# FTP_PORT=21
# FTP_USER=your_cpanel_username
# FTP_PASS=your_ftp_password
# Remote path to Multi-Hospital root (often public_html or public_html/Multi-Hospital). Use forward slashes.
# FTP_REMOTE_DIR=/public_html

# --- Chamber practice SaaS ---
# CHAMBER_OTP_TTL=300
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_SANDBOX=1
# Per-hospital SSLCommerz can be set in Finance → Payment gateways (overrides env for session init).
# IPN: payment_bd/sslcommerz_ipn (also whitelist in firewall; CSRF excluded in config.php).
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_SANDBOX=1
