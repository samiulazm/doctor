# Copy from .env.example; never commit .env (gitignored).
# CI_ENV is read in index.php (development | testing | production).

CI_ENV=production

# Public URL (with trailing slash). Use https:// when SSL is active in cPanel.
CI_BASE_URL=https://programmingman.com/

# CodeIgniter encryption key (32+ chars).
CI_ENCRYPTION_KEY=6aba9e2ae161d5a1ca896a286f23fc2bbe5dcc9be91a6afd5c2792b4752d296c

# Database — cPanel MySQL (use localhost on shared hosting)
CI_DB_HOST=localhost
CI_DB_USER=programm_shosti
CI_DB_PASSWORD="7eW#roG;dpn&kxhP"
CI_DB_NAME=programm_prod

# Session file path (optional; default is application/cache/sessions)
# CI_SESSION_PATH=

# If users hit both www and apex, list allowed hosts for safe redirects:
#CI_ALLOW_REDIRECT_HOSTS=www.programmingman.com,programmingman.com

